# ============================================================
# Renzo — Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to git.

# --- Job Source API Keys ---
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key

# --- Fetcher Config ---
SEARCH_KEYWORDS=python developer
MAX_WORKERS=5
PAGINATION_PAGES=3
REQUEST_TIMEOUT=10
RETRY_ATTEMPTS=3
JOB_FETCH_LIMIT=500
MAX_JOB_AGE_HOURS=6

# --- Database ---
# "sqlite" (default, local dev/tests) or "postgres" (production)
DB_BACKEND=sqlite
DB_TYPE=sqlite
DB_PATH=data/jobs.db

# Postgres DSN — only required when DB_BACKEND=postgres
# Format: host=<host> port=5432 dbname=<db> user=<user> password=<pass> sslmode=require
PG_DSN=

# Postgres pool size (when DB_BACKEND=postgres)
PG_POOL_MIN=2
PG_POOL_MAX=10

# --- Supabase ---
# Get these from your Supabase project: Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Get from: Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# --- Authentication ---
# Set to "true" to enforce JWT on all non-health endpoints
# Set to "false" (default) for local development without Supabase
AUTH_ENABLED=false

# --- Logging ---
LOG_FORMAT=readable
